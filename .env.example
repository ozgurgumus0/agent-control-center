# Copy to .env and fill in. Never commit .env.

# --- LLM agents (Analyst, Investigator, Context Scout) ----------------------
ANTHROPIC_API_KEY=

# --- Sibling projects this control center reads from ------------------------
# Attribution/monitoring project (measurement tables, incidents, policy, event registry).
ATTRIBUTION_PROJECT_ROOT=
# The budget planner / allocation tool (backend on :8000, frontend on :5173).
PLANNER_ROOT=
PLANNER_API_URL=http://127.0.0.1:8000
# ev_score.sql inside the planner (defaults to <PLANNER_ROOT>/planner/sql/ev_score.sql).
PLANNER_EV_SQL=
# Folder where planner exports (Budget_Allocation_*.xlsx) are dropped.
PLANNER_EXPORT_DIR=
# data_source value that marks a planner run built on production data.
PLANNER_PRODUCTION_SOURCE=warehouse
# Allocator backtest extract (predictions_weekly.csv.gz).
ALLOCATOR_DATA=

# --- Ads automation project (budget snapshots via its fetchers.budgets) -----
# That project holds its own platform credentials (Meta / Google Ads tokens).
ADS_AUTOMATION_ROOT=
# Creative ad performance Google Sheet (read-only, service account).
GOOGLE_SHEETS_ID_PRODUCTION=
GOOGLE_SERVICE_ACCOUNT_FILE=
# JSON list of [channel, lower-case campaign-name fragment] pairs to exclude.
CAMPAIGN_EXCLUDE_RULES=[]

# --- LOI (consultation scoring) project ------------------------------------
LOI_OUTPUTS_DIR=
# Glob, relative to the workspace root, for the CRM export the Leak Tracer scans.
CRM_EXPORT_GLOB=

# --- Briefing PDF ------------------------------------------------------------
BRIEFING_AUTHOR=
BRIEFING_ORG_NAME=
BRIEFING_LOGO_PATH=

# --- Tests (optional: enables tests that need a local incident folder) -------
TEST_INCIDENT_ID=
